---
layout: base.njk
title: Recommended Instructors
description: Recommended sidemount scuba diving instructors around the world. Hand-picked technical and recreational sidemount instructors with proven standards.
permalink: /instructors/
---

<style>
  /* Override default header hover — brand orange instead of the generic
     light-grey wash, so it's clear which columns are clickable/sortable. */
  .instructors-table th[data-sort]:hover {
    color: var(--sa-signal);
    background: rgba(255, 90, 31, 0.08);
  }
</style>

<div class="instructors-page">

  <header class="page-hero">
    <div class="container">
      <span class="eyebrow">Worldwide Network</span>
      <h1>Recommended Instructors</h1>
      <p>This lists exists for those looking for sidemount training who can not train or choose not to train with Sidemount Authority. These are sidemount instructors around the world that I personally recommend. Each one meets the standards I consider non-negotiable for quality sidemount instruction. This list is random and in no partcular order.</p>
    </div>
  </header>

  <section class="instructors-section" aria-labelledby="instructors-heading">
    <div class="container">
      <div class="sr-only" id="instructors-heading">Recommended instructor directory</div>

{% if collections.instructors.length %}
      <div class="instructors-table-wrap">
        <table class="instructors-table" id="instructors-table" style="opacity:0; transition: opacity 0.15s ease;">
          <thead>
            <tr>
              <th scope="col" data-sort="0" data-sort-type="lastname">Name</th>
              <th scope="col" data-sort="1">Location</th>
              <th scope="col">Agency</th>
              <th scope="col">Contact</th>
              <th scope="col">Notes</th>
            </tr>
          </thead>
          <tbody>
            {% for instructor in collections.instructors %}
            <tr>
              <td>{{ instructor.data.name }}</td>
              <td>{{ instructor.data.location }}</td>
              <td><span class="mono">{{ instructor.data.agency }}</span></td>
              <td>
                {% if instructor.data.email %}
                <a href="mailto:{{ instructor.data.email }}">{{ instructor.data.email }}</a>
                {% else %}
                <span class="text-faint mono">—</span>
                {% endif %}
              </td>
              <td class="text-dim" style="font-size:0.875rem;">{{ instructor.data.notes or "—" }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <script>
        document.addEventListener("DOMContentLoaded", function () {
          const table = document.getElementById("instructors-table");
          if (!table) return;

          const tbody = table.querySelector("tbody");
          const headers = table.querySelectorAll("th[data-sort]");

          // ── Extract a sortable key from a cell's text.
          // For the Name column, use the LAST word (last name) instead of
          // the full string, so sorting groups people by surname rather
          // than by whichever name happens to come first alphabetically.
          function getSortKey(cell, sortType) {
            const text = cell.textContent.trim();
            if (sortType === "lastname") {
              const parts = text.split(/\s+/);
              return parts[parts.length - 1].toLowerCase();
            }
            return text.toLowerCase();
          }

          // ── Shuffle helper (Fisher–Yates) so no instructor is
          // advantaged/disadvantaged by always appearing first or last.
          // Runs once per page load — a fresh random order every visit.
          function shuffle(array) {
            for (let i = array.length - 1; i > 0; i--) {
              const j = Math.floor(Math.random() * (i + 1));
              [array[i], array[j]] = [array[j], array[i]];
            }
            return array;
          }

          // Randomize initial row order before the table becomes visible,
          // so every visitor sees a different starting arrangement and
          // must actively choose a column to sort by.
          const initialRows = Array.from(tbody.querySelectorAll("tr"));
          shuffle(initialRows).forEach(function (row) {
            tbody.appendChild(row);
          });
          table.style.opacity = "1";

          headers.forEach(function (th) {
            th.style.cursor = "pointer";
            th.addEventListener("click", function () {
              const colIndex = parseInt(th.getAttribute("data-sort"), 10);
              const sortType = th.getAttribute("data-sort-type") || "text";
              const dir = th.getAttribute("data-sort-dir") === "asc" ? "desc" : "asc";

              headers.forEach(function (h) {
                h.removeAttribute("data-sort-dir");
                h.classList.remove("sort-asc", "sort-desc");
              });
              th.setAttribute("data-sort-dir", dir);
              th.classList.add(dir === "asc" ? "sort-asc" : "sort-desc");

              const rows = Array.from(tbody.querySelectorAll("tr"));
              rows.sort(function (a, b) {
                const aVal = getSortKey(a.children[colIndex], sortType);
                const bVal = getSortKey(b.children[colIndex], sortType);
                if (aVal < bVal) return dir === "asc" ? -1 : 1;
                if (aVal > bVal) return dir === "asc" ? 1 : -1;
                return 0;
              });

              rows.forEach(function (row) {
                tbody.appendChild(row);
              });
            });
          });
        });
      </script>
      {% else %}
      <div class="no-posts">
        <p class="eyebrow">Coming Soon</p>
        <p>Instructor listings will be published shortly.</p>
      </div>
      {% endif %}

    </div>
  </section>

  <section class="cta-band" aria-labelledby="instructor-cta-heading">
    <div class="container">
      <h2 id="instructor-cta-heading">Are you a sidemount instructor?</h2>
      <p>If you believe you meet the standards for inclusion on this list, get in touch and let's talk.</p>
      <div class="cta-buttons">
        <a href="/contact/" class="btn btn-signal">Get in Touch</a>
      </div>
    </div>
  </section>

</div>
